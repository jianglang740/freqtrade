{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "futures",
    "margin_mode": "cross",
    "max_open_trades": 2,
    "stake_currency": "USDT",
    "stake_amount": 200,
    "tradable_balance_ratio": 1,
    "fiat_display_currency": "",
    "dry_run": true,
    "timeframe": "4h",
    "dry_run_wallet": 10000,
    "cancel_open_orders_on_exit": true,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 30
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "enable_ws": false,
        "ccxt_config": {
            "socksProxy": "socks5h://127.0.0.1:1080"
        },
        "ccxt_async_config": {
            "socksProxy": "socks5h://127.0.0.1:1080"
        },
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "bot_name": "turtle_4h",
    "force_entry_enable": true,
    "initial_state": "running",
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8082,
        "verbosity": "error",
        "enable_openapi": true,
        "jwt_secret_key": "kYuEeRBkBYOS6dV71QBBhLROEE2JUIn0Rp0xCMIOHoWT4brsS1WD7ZRWCPa0pg9S",
        "CORS_origins": [],
