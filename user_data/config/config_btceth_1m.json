{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "//": "Ema21TwoTfAtr 的跨品种对照 config（BTC + ETH）。与 config_xau_1m.json 的差别只有白名单，其余口径完全一致，保证横向可比。",
    "//timerange": "不在这里写死 —— 三段窗口由命令行 --timerange 指定：W1 20210101-20211101 / W2 20220201-20221201 / W3 20230601-20240401。",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "dry_run": true,
    "dry_run_wallet": 10000,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "timeframe": "1m",
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "enable_ws": false,
        "//proxy": "本机出海要走 socks 代理，与 config_grid_1h.json 一致。回测只用本地 feather 数据，但启动时仍要拉一次交易所元数据。",
        "ccxt_config": {
            "socksProxy": "socks5h://127.0.0.1:1080"
        },
        "ccxt_async_config": {
            "socksProxy": "socks5h://127.0.0.1:1080"
        },
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "internals": {
        "process_throttle_secs": 5
    },
    "dataformat_ohlcv": "feather"
}
