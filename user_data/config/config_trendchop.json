{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "//": "TrendChop 回测配置（策略池/AlphaPilot复现 S5）。研究口径：BTC/ETH/SOL 日线、3bp、真实资金费。",
    "trading_mode": "futures",
    "margin_mode": "cross",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 1,
    "dry_run": true,
    "dry_run_wallet": 10000,
    "timeframe": "1d",
    "cancel_open_orders_on_exit": true,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 30
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "enable_ws": false,
        "ccxt_config": {
            "socksProxy": "socks5h://127.0.0.1:1080"
        },
        "ccxt_async_config": {
            "socksProxy": "socks5h://127.0.0.1:1080"
        },
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "bot_name": "trendchop_1d",
    "initial_state": "stopped",
    "internals": {
        "process_throttle_secs": 300
    },
    "db_url": "sqlite:///tradesv3.trendchop.sqlite",
    "dataformat_ohlcv": "feather"
}
