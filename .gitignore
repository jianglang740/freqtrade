# 四、IDE 与操作系统
# ═══════════════════════════════════════════════════════════════

# macOS
.DS_Store

# IDE
.idea
.vscode

# Django/Flask/Scrapy 遗留规则
*.log
local_settings.py
instance/
.webassets-cache
.scrapy

# 临时诊断目录
.tmp_*/

# 临时文件
crypto_price_data.parquet
price_data.parquet
crypto_price_data_说明.md
user_data/config/config_spot_research.json