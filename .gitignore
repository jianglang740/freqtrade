# ╔══════════════════════════════════════════════════════════════╗
# ║              Freqtrade 项目 .gitignore                        ║
# ║  本地开发 → git push → 云服务器 git pull 工作流               ║
# ╚══════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════
# 一、用户数据 — 选择性跟踪
# ═══════════════════════════════════════════════════════════════

# ── 配置文件 ──
# ❌ 含真实交易所 API 密钥，绝不允许提交
user_data/config/config_okx.json
# ✅ 以下配置文件可以提交（不含真实密钥，云/本地通用）
# user_data/config/config_all.json
# user_data/config/config_server.json
# user_data/config/config_okx_zh.jsonc

# ── 策略代码 ✅ 会被 Git 跟踪 ──
# user_data/strategies/*.py     ← 你的策略逻辑
# user_data/strategies/*.md     ← 策略文档
# ❌ 不覆盖官方示例
!user_data/strategies/sample_strategy.py

# ── 行情数据（.feather 文件） ──
# ❌ 太大（几百 MB ~ GB），不适合 git
# 💡 如果需要云服务器共享数据，把这行注释掉即可
user_data/data/*

# ── 回测结果 ──
# ❌ 运行时生成的 ZIP/JSON，不需要版本控制
user_data/backtest_results/*

# ── 超参优化结果 ──
# ❌ 优化产生的中间文件
user_data/hyperopt_results/*

# ── 日志 ──
# ❌ 本地日志文件，不跟踪
*.log
logfile.txt
user_data/logs/*

# ── FreqAI 模型 ──
# ❌ 训练好的模型文件，体积大
user_data/freqaimodels/*
user_data/models/*

# ── 数据库（SQLite） ──
# ❌ 实盘/模拟盘的交易记录数据库，本地独有
*.sqlite
*.sqlite-shm
*.sqlite-wal

# ── 画图输出 ──
# ❌ plot-dataframe / plot-profit 生成的 HTML
freqtrade-plot.html
freqtrade-profit-plot.html

# ── Jupyter Notebook ──
# ❌ 默认不跟踪，想同步删掉下面这行
user_data/notebooks/*

# ── .gitkeep 占位文件 ──
# ✅ 保留空目录的占位文件
!*.gitkeep


# ═══════════════════════════════════════════════════════════════
# 二、Freqtrade 框架文件 — 不跟踪
# ═══════════════════════════════════════════════════════════════

# WebUI 前端（通过 `freqtrade install-ui` 从 GitHub Release 下载的 ZIP 解压产物）
# ❌ 不属于源码，每个环境自己 install-ui
freqtrade/rpc/api_server/ui/*

# TA-Lib 编译产物
build_helpers/ta-lib/*

# 配置文件示例（✅ 官方示例允许提交）
!config_examples/config_binance.example.json
!config_examples/config_full.example.json
!config_examples/config_kraken.example.json
!config_examples/config_freqai.example.json

# Docker Compose 自定义配置
docker-compose-*.yml


# ═══════════════════════════════════════════════════════════════
# 三、Python 项目通用
# ═══════════════════════════════════════════════════════════════

# 编译缓存
__pycache__/
*.py[cod]
*$py.class

# C 扩展
*.so

# 打包/分发
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# pip
pip-log.txt
pip-delete-this-directory.txt

# 虚拟环境
.venv
.env

# 测试/覆盖率
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# 文档
docs/_build/
site/

# 翻译
*.mo
*.pot

# Jupyter
*.ipynb_checkpoints

# pyenv
.python-version

# 其他
target/
memray-*
.*_cache/


