{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "futures",
    "margin_mode": "cross",
    "max_open_trades": 40,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 1,
    "dry_run": true,
    "dry_run_wallet": 10000,
    "timeframe": "4h",
    "cancel_open_orders_on_exit": true,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 30
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "socksProxy": "socks5h://127.0.0.1:1080",
            "timeout": 60000
        },
        "ccxt_async_config": {
            "socksProxy": "socks5h://127.0.0.1:1080",
            "timeout": 60000
        },
        "pair_whitelist": [
            "AAVE/USDT:USDT",
            "ADA/USDT:USDT",
            "ALGO/USDT:USDT",
            "APT/USDT:USDT",
            "ARB/USDT:USDT",
            "ATOM/USDT:USDT",
            "AVAX/USDT:USDT",
            "BCH/USDT:USDT",
            "BNB/USDT:USDT",
            "BTC/USDT:USDT",
            "CRV/USDT:USDT",
            "DASH/USDT:USDT",
            "DOGE/USDT:USDT",
            "DOT/USDT:USDT",
            "ETC/USDT:USDT",
            "ETH/USDT:USDT",
            "FET/USDT:USDT",
            "FIL/USDT:USDT",
            "GALA/USDT:USDT",
            "HBAR/USDT:USDT",
            "ICP/USDT:USDT",
            "INJ/USDT:USDT",
            "LDO/USDT:USDT",
            "LINK/USDT:USDT",
            "LTC/USDT:USDT",
            "NEAR/USDT:USDT",
            "OP/USDT:USDT",
            "PENDLE/USDT:USDT",
            "RUNE/USDT:USDT",
            "SOL/USDT:USDT",
            "SUI/USDT:USDT",
            "TRX/USDT:USDT",
            "UNI/USDT:USDT",
            "WLD/USDT:USDT",
            "XLM/USDT:USDT",
            "XRP/USDT:USDT",
            "ZEC/USDT:USDT"
        ],
        "pair_blacklist": [],
        "_ft_has_params": {
            "funding_fee_candle_limit": 200,
            "mark_ohlcv_timeframe": "4h"
        }
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "bot_name": "brooks_pa",
    "initial_state": "running"
}
