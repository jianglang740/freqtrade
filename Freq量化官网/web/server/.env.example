# 复制成 .env 后填写；.env 已被 gitignore，绝不入库
# 生成密钥：
#   JWT_SECRET:     openssl rand -base64 48
#   ENCRYPTION_KEY: openssl rand -base64 32   （必须恰好 32 字节的 base64）

NODE_ENV=development
HOST=127.0.0.1
PORT=3002

# SQLite 文件位置；相对路径以 server/ 为基准
DATABASE_PATH=./data/freq.db

# 会话签名密钥，至少 32 个字符
JWT_SECRET=

# 机器人密码加密密钥，32 字节 base64
ENCRYPTION_KEY=

# 会话有效期（小时）
SESSION_HOURS=12

# 生产环境（HTTPS）必须为 true；本地 http 调试用 false
COOKIE_SECURE=false

# 只读面板：true 时只有 superadmin 能添加机器人
CUSTOMER_READ_ONLY=true

# 允许发起写请求的站点来源（CSRF 白名单），逗号分隔
PUBLIC_ORIGINS=http://127.0.0.1:4000,http://localhost:4000

# 机器人地址是否允许内网/回环地址（freqtrade 通常部署在本机或内网）
BOT_ALLOW_PRIVATE=true

# 如果前面有 Nginx 等反向代理，设为 true 才能拿到真实客户端 IP
TRUST_PROXY=false

# 前端构建产物目录；不填则默认 web/dist
# STATIC_DIR=

# 策略 / 因子 Markdown 与图片目录；不填则默认 server/content（相对路径以 server/ 为基准）
# CONTENT_DIR=

# 是否打印每个请求的日志；默认只记错误和慢请求（高并发时 stdout 也会抢事件循环）
LOG_REQUESTS=false

# 限流阈值：按用户计数，避免共用 NAT 出口 IP 的客户被互相误伤。
# 每个客户一个标签页约 4 次/15 秒（≈16 次/分钟），以下默认值留了十几倍余量。
RATE_LIMIT_API_IP_PER_MIN=3000
RATE_LIMIT_USER_PER_MIN=600
RATE_LIMIT_PROXY_USER_PER_MIN=300
RATE_LIMIT_PROXY_BOT_PER_MIN=240
RATE_LIMIT_LOGIN_PER_15MIN=10
