    {
      "id": "9IlosyRtXxfuVY7IzrvOp",
      "type": "text",
      "x": 2170.373381483766,
      "y": 248.78208915800343,
      "width": 400.2581407694825,
      "height": 101.05542125558203,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
