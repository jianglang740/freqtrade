      "index": "am",
      "roundness": null,
      "seed": 1454025804,
      "version": 844,
      "versionNonce": 1339799412,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794066262411,
      "created": 1794062089410,
      "link": null,
      "locked": false,
      "text": "我们将为您提供机器人的登录信息，获取信\n息后只需点击网站右上角的“登录到机器人”\n按钮，即可在后台监控您的机器人运行状\n态、绩效等，并对其进行操控.",
      "fontSize": 20.211084251116407,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "我们将为您提供机器人的登录信息，获取信息后只需点击网站右上角的“登录到机器人”按钮，即可在后台监控您的机器人运行状态、绩效等，并对其进行操控.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "oEynmuzZbDmE016YwsYRJ",
      "type": "text",
      "x": 1425.7541294395892,
      "y": 488.4306107235175,
      "width": 736,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
