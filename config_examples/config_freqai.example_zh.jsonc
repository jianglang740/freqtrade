{
    // ================================================================
    // Freqtrade FreqAI 机器学习配置（中文注释版）
    // ================================================================
    // 本配置演示如何在合约交易中启用 FreqAI 机器学习模块。
    // FreqAI 会自动训练模型来预测市场走势，用于辅助策略决策。
    // ================================================================

    "$schema": "https://schema.freqtrade.io/schema.json",

    // =================================================================
    // 交易模式：合约
    // =================================================================
    // 合约交易模式
    "trading_mode": "futures",
    // 逐仓模式（isolated）：每个仓位独立保证金，互不影响
    // 全仓模式（cross）：所有仓位共享保证金
    "margin_mode": "isolated",

    // 最大同时持仓数量
    "max_open_trades": 5,

    // 报价货币
    "stake_currency": "USDT",
    // 每笔投入金额
    "stake_amount": 200,

    // 可用资金比例。1 = 全部可用
    "tradable_balance_ratio": 1,

    // 法币显示货币
    "fiat_display_currency": "USD",

    // 模拟交易
    "dry_run": true,

    // 较短的K线周期（3 分钟），适合机器学习高频预测
    "timeframe": "3m",

    // 模拟初始资金
    "dry_run_wallet": 1000,

    // 退出时取消所有挂单（合约建议开启，避免未成交单风险）
    "cancel_open_orders_on_exit": true,

    // =================================================================
    // 未成交订单超时（合约下单成交快，超时可以设短一些）
    // =================================================================
    "unfilledtimeout": {
        "entry": 10,
        "exit": 30         // 离场给 30 分钟，防止滑点
    },

    // =================================================================
    // 交易所（Binance 合约）
    // =================================================================
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",

        "ccxt_config": {},
        "ccxt_async_config": {},

        // ======= 合约交易对格式 =======
        // 格式：BASE/QUOTE:结算货币
        // "1INCH/USDT:USDT" = 1INCH 合约，USDT 计价，USDT 结算
        "pair_whitelist": [
            "1INCH/USDT:USDT",
            "ALGO/USDT:USDT"
        ],

        "pair_blacklist": []
    },

    // =================================================================
    // 入场定价
    // =================================================================
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },

    // =================================================================
    // 离场定价（合约建议用 other，即卖出用卖一价，防止滑点）
    // =================================================================
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },

    // 静态白名单
    "pairlists": [
        {"method": "StaticPairList"}
    ],

    // =================================================================
    // ⭐ FreqAI 机器学习配置（核心部分）
    // =================================================================
    "freqai": {
        // 启用 FreqAI
        "enabled": true,

        // 保留最近 N 个训练好的模型，旧的自动清理
        "purge_old_models": 2,

        // 训练数据天数（回看多少天的历史数据来训练）
        "train_period_days": 15,

        // 回测数据天数（用于评估模型表现）
        "backtest_period_days": 7,

        // 回测时是否保存训练好的模型。false 可节省磁盘空间
        "save_backtest_models": false,

        // 实盘时重新训练模型的小时间隔。0 = 仅启动时训练一次
        "live_retrain_hours": 0,

        // 唯一标识符，区分不同 FreqAI 策略
        // 修改此值会创建新的独立目录，不覆盖旧模型
        "identifier": "unique-id",

        // ----------------------------------------------------------
        // 特征参数（特征工程配置）
        // ----------------------------------------------------------
        "feature_parameters": {
            // 包含哪些时间框架的数据作为特征
            // 除了主时间框架 3m，还纳入 15m 和 1h 的数据
            "include_timeframes": [
                "3m",
                "15m",
                "1h"
            ],

            // 相关性交易对列表，纳入模型作为辅助特征
            // 例如 BTC 和 ETH 的走势往往会影响其他币
            "include_corr_pairlist": [
                "BTC/USDT:USDT",
                "ETH/USDT:USDT"
            ],

            // 标签周期（K线数）。模型预测未来 N 根K线后的涨跌
            // 20 根 3 分钟K线 = 预测未来 1 小时的价格走向
            "label_period_candles": 20,

            // 偏移K线数。纳入前 N 根K线的特征
            // 2 = 当前 + 前 2 根K线的指标作为特征
            "include_shifted_candles": 2,

            // 去重阈值（Dissimilarity Index）
            // 0.9 = 相似度 > 90% 的特征对被移除，减少冗余
            "DI_threshold": 0.9,

            // 权重因子。0.9 = 越新的数据点权重越高
            "weight_factor": 0.9,

            // 是否启用 PCA（主成分分析）降维
            "principal_component_analysis": false,

            // 是否使用 SVM（支持向量机）去除离群值
            "use_SVM_to_remove_outliers": true,

            // 指标周期列表。为每个周期计算一组技术指标
            "indicator_periods_candles": [
                10,    // 10 根K线的指标
                20     // 20 根K线的指标
            ],

            // 特征重要性图表。0=不绘制
            "plot_feature_importances": 0
        },

        // ----------------------------------------------------------
        // 数据划分参数
        // ----------------------------------------------------------
        "data_split_parameters": {
            // 测试集占比。0.33 = 33% 数据用于测试，67% 用于训练
            "test_size": 0.33,
            // 随机种子（保证结果可复现）
            "random_state": 1
        },

        // ----------------------------------------------------------
        // 模型训练参数
        // 留空则使用各模型（LightGBM/XGBoost/回归）的默认参数
        // 可以在此覆盖，例如：
        // "model_training_parameters": {
        //     "n_estimators": 500,
        //     "learning_rate": 0.05
        // }
        // ----------------------------------------------------------
        "model_training_parameters": {}
    },

    // 机器人名称
    "bot_name": "",

    // 允许强制入场（FreqAI 建议配合手动干预使用）
    "force_entry_enable": true,

    "initial_state": "running",

    "internals": {
        "process_throttle_secs": 5
    }
}
